  - _key: skill.marksman.binding-shot.name
    _text: Binding Shot
  - _key: skill.marksman.binding-shot.description
    _text: 'Chains an enemy to whatever is behind it: another enemy, a stone, a tree
      or a wall. Both are stunned.'

    _text: 'Killshot 2'
  - _key: skill.marksman.killshot-2.description
    _text: 'Killshot deals 25% more damage and executes non-bosses at 20% HP or below.'
  - _key: skill.marksman.killshot-3.name
    _text: 'Killshot 3'
